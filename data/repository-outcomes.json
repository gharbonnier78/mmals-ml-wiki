  "status_definitions": {
    "supported": "A bounded claim has supporting executed evidence; read the source for exact scope.",
    "mixed": "Evidence supports some bounded aspects while other claims/gates fail or remain unqualified.",
    "negative": "A predeclared or load-bearing claim is not demonstrated / not supported in the registered evidence.",
    "hypothesis": "Research direction, protocol or theory bridge not yet established by qualifying evidence.",
    "specification": "Architecture/specification outcome; not a scientific validation by itself.",
    "tool": "Implemented/replayable tool or infrastructure outcome; not a scientific result by itself.",
    "governance": "Reusable method, contract or assurance outcome.",
    "pedagogy": "Learning/publication artifact that explains primary sources without replacing them.",
    "legacy": "Retained for history; no current research outcome."
  },
